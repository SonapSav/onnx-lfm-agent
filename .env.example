# Copy to .env. Points the agent at a running onnx-lfm-api server.
# Local venv runs use 127.0.0.1; under docker compose the default is
# http://onnx-lfm-api:8383/v1 (leave LFM_URL unset there).
# LFM_URL=http://127.0.0.1:8383/v1
# LFM_API_KEY=your-key        # only if the API has auth enabled
# LFM_MODEL=lfm2.5
# LFM_MAX_ROUNDS=6
# LFM_TEMPERATURE=0.1         # API default; 0.0 only for reproducible test/eval runs
# LFM_TOOL_POLICY=              # per-tool overrides: name=allow|ask|deny,... (default:
#                               # read-only allow, dangerous ask; "ask" = denied in the server)

# --- HTTP service (lfm-agent-server / docker compose up -d) ---
# Required; clients send it as X-API-Key or Authorization: Bearer. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# LFM_AGENT_API_KEY=
# LFM_HOST=127.0.0.1            # compose sets 0.0.0.0 inside the container
# LFM_PORT=8384

# --- Model behaviour ---
# LFM_SYSTEM_PROMPT=            # unset/empty = none (default); builtin = the short built-in prompt; text = use that

# --- Tools ---
# LFM_TOOLSETS=workspace        # "workspace" (files + config), "demo" (time, add); comma-separated
# LFM_WORKSPACE=workspace       # the only dir file tools may touch (container: /workspace)
# LFM_WORKSPACE_HOST=./workspace  # docker compose: host dir mounted at /workspace
