# Copy to .env. Points the agent at a running onnx-lfm-api server.
# Local venv runs use 127.0.0.1; under docker compose the default is
# http://onnx-lfm-api:8383/v1 (leave LFM_URL unset there).
# LFM_URL=http://127.0.0.1:8383/v1
# LFM_API_KEY=your-key        # only if the API has auth enabled
# LFM_MODEL=lfm2.5
# LFM_MAX_ROUNDS=6
# LFM_TEMPERATURE=0.1         # API default; 0.0 only for reproducible test/eval runs
