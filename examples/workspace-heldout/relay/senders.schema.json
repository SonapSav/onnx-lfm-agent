{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mx-relay internal sender clients",
  "type": "object",
  "additionalProperties": false,
  "required": ["default_max_msgs_per_hour", "clients"],
  "properties": {
    "default_max_msgs_per_hour": {"type": "integer", "minimum": 1, "maximum": 10000},
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cidr", "auth_required", "max_msgs_per_hour"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
          "cidr": {"type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"},
          "auth_required": {"type": "boolean"},
          "max_msgs_per_hour": {"type": "integer", "minimum": 1, "maximum": 10000}
        }
      }
    }
  }
}
