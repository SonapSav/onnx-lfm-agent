{
  "agent": {
    "name": "edge-shipper-01",
    "log_level": "info"
  },
  "scrape": {
    "interval_s": 15,
    "timeout_s": 10,
    "targets": [
      {"job": "node", "address": "10.20.0.11:9100"},
      {"job": "node", "address": "10.20.0.17:9100"},
      {"job": "mxrelay", "address": "10.20.3.5:9154"},
      {"job": "backupd", "address": "10.20.6.2:9469"}
    ]
  },
  "batch": {
    "max_samples": 20000,
    "flush_interval_s": 5
  },
  "queue": {
    "capacity": 200000,
    "max_shards": 8,
    "retry_backoff_ms": 500
  },
  "remote_write": {
    "url": "https://metrics-store.internal.example:9443/api/v1/write",
    "timeout_s": 30,
    "tls": {
      "ca_file": "/etc/ssl/certs/corp-internal-ca.pem",
      "insecure_skip_verify": true
    }
  }
}
