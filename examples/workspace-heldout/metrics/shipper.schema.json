{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metrics shipper configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "scrape", "batch", "queue", "remote_write"],
  "properties": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "log_level"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]{1,63}$"},
        "log_level": {"type": "string", "enum": ["debug", "info", "warn", "error"]}
      }
    },
    "scrape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_s", "timeout_s", "targets"],
      "properties": {
        "interval_s": {"type": "integer", "minimum": 1, "maximum": 300},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 60},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "address"],
            "properties": {
              "job": {"type": "string", "pattern": "^[a-z0-9_-]{1,40}$"},
              "address": {"type": "string", "pattern": "^[A-Za-z0-9.-]+:\\d{1,5}$"}
            }
          }
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_samples", "flush_interval_s"],
      "properties": {
        "max_samples": {"type": "integer", "minimum": 100, "maximum": 100000},
        "flush_interval_s": {"type": "integer", "minimum": 1, "maximum": 60}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "max_shards", "retry_backoff_ms"],
      "properties": {
        "capacity": {"type": "integer", "minimum": 1000, "maximum": 5000000},
        "max_shards": {"type": "integer", "minimum": 1, "maximum": 64},
        "retry_backoff_ms": {"type": "integer", "minimum": 10, "maximum": 60000}
      }
    },
    "remote_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "timeout_s", "tls"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://\\S+$"},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 300},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ca_file", "insecure_skip_verify"],
          "properties": {
            "ca_file": {"type": "string", "minLength": 1, "maxLength": 4096},
            "insecure_skip_verify": {"type": "boolean"}
          }
        }
      }
    }
  }
}
